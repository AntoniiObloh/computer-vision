# Virtual environment
.venv/
venv/

# Python
__pycache__/
*.py[cod]
.Python

# Jupyter
.ipynb_checkpoints/

# Runtime logs
logs/

# Generated by the notebooks — reproducible, no reason to commit
outputs/

# Model weights — downloaded by the notebooks (goturn.caffemodel alone is ~370 MB)
models/goturn.caffemodel
models/pose_body25/*.caffemodel
models/*.tar.gz
models/*.zip
models/*.zip.[0-9][0-9][0-9]

# PyCharm — keep the shared project config, ignore the per-user bits
.idea/workspace.xml
.idea/shelf/
.idea/usage.statistics.xml
.idea/dictionaries/
.idea/httpRequests/

# macOS
.DS_Store

# IDE and local agent settings
.idea/
.claude/

# Model weights — fetched by scripts/download_models.py, not stored in git
models/*.onnx
models/*.caffemodel
models/*.pb
data/*.caffemodel
models/ssd_mobilenet_v2_coco_2018_03_29/**
!models/ssd_mobilenet_v2_coco_2018_03_29/*.pbtxt
!models/ssd_mobilenet_v2_coco_2018_03_29/*.txt

# Duplicate videos in .avi — only the .mp4 versions are kept
videos/*.avi
